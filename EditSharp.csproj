<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EditSharp</RootNamespace>
    <AssemblyName>EditSharp</AssemblyName>

    <!-- EditSharp.xml beside the dll for doc tools; a public member without a summary warns (CS1591) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Packable from day one so "publish to a feed" is a `dotnet pack` away
         once there's a second consumer, without touching the project file. -->
    <IsPackable>true</IsPackable>
    <PackageId>EditSharp</PackageId>
    <Version>0.1.2</Version>
    <Description>C#/ffmpeg timeline video (and, eventually, image) editing pipeline.</Description>
    <Authors>CoolBeansStudio</Authors>
    <RepositoryUrl>https://github.com/EditSharp/EditSharp</RepositoryUrl>
    <PackageProjectUrl>https://editsharp.github.io/</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE;README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
